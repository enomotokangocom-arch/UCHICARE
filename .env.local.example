# Claude API キー (企業課題チャット・記事自動作成のAI応答に使用)
# https://console.anthropic.com/ で発行してください
ANTHROPIC_API_KEY=

# ---- Uchi OS (docs/uchi-os/) ----
# PostgreSQL接続文字列。ローカル開発では `npx prisma migrate dev` の前に設定してください。
DATABASE_URL="postgresql://uchi_os:uchi_os_dev_password@localhost:5432/uchi_os_dev?schema=public"
# セッションCookie(JWT)の署名鍵。`openssl rand -hex 32` 等で生成してください。
# 未設定の場合は開発用の固定フォールバック値が使われます(本番では必ず設定すること)。
AUTH_SECRET=

# WordPress連携 (記事自動作成 → 承認済み記事のWordPress下書き送信に使用)
# WORDPRESS_URL は WordPress サイトのトップURL (例: https://example.com)
# WORDPRESS_USERNAME と WORDPRESS_APP_PASSWORD は、WordPress管理画面の
# 「ユーザー」→ 対象ユーザーの「プロフィール」→ 「アプリケーションパスワード」から発行してください。
# (通常のログインパスワードではありません)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

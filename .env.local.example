# Claude API キー (企業課題チャット・記事自動作成のAI応答に使用)
# https://console.anthropic.com/ で発行してください
ANTHROPIC_API_KEY=

# WordPress連携 (記事自動作成 → 承認済み記事のWordPress下書き送信に使用)
# WORDPRESS_URL は WordPress サイトのトップURL (例: https://example.com)
# WORDPRESS_USERNAME と WORDPRESS_APP_PASSWORD は、WordPress管理画面の
# 「ユーザー」→ 対象ユーザーの「プロフィール」→ 「アプリケーションパスワード」から発行してください。
# (通常のログインパスワードではありません)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ---- Uchi Management OS（/mos）----
# PostgreSQL 接続先
DATABASE_URL=postgresql://user:password@localhost:5432/uchi_mos
# 統合テスト用 DB（npm test で使用。未設定なら DB 統合テストはスキップ）
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/uchi_mos_test
# セッション署名鍵（32文字以上のランダム文字列）
MOS_SESSION_SECRET=
# 利用者ID・職員IDのハッシュ化鍵（32文字以上。変更すると過去データと突合できなくなるため固定）
MOS_HASH_SECRET=
# 毎朝8時の自動再計算 API の認証（Vercel Cron は Authorization: Bearer <CRON_SECRET> を送る）
CRON_SECRET=

# Claude API キー (企業課題チャット・記事自動作成のAI応答に使用)
# https://console.anthropic.com/ で発行してください
ANTHROPIC_API_KEY=

# WordPress連携 (記事自動作成 → 承認済み記事のWordPress下書き送信に使用)
# WORDPRESS_URL は WordPress サイトのトップURL (例: https://example.com)
# WORDPRESS_USERNAME と WORDPRESS_APP_PASSWORD は、WordPress管理画面の
# 「ユーザー」→ 対象ユーザーの「プロフィール」→ 「アプリケーションパスワード」から発行してください。
# (通常のログインパスワードではありません)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ---------------------------------------------------------------------------
# 採用CRM (LINE友だち管理・候補者データベース)
# ---------------------------------------------------------------------------

# データベース接続文字列。開発時は SQLite のファイルを利用します。
# 本番運用ではPostgreSQL等に差し替えてください (例: postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# 管理画面ログイン用セッションの署名鍵 (32文字以上のランダムな文字列を設定してください)
# 生成例: openssl rand -base64 32
AUTH_SECRET=

# 初回セットアップ用の管理者アカウント (npm run db:seed で作成されます)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# LINE Messaging API (LINE Developersコンソールで発行)
# Channel Secret は Webhook署名検証に使用するため必須です。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ステップ配信・再ヒアリングなどの定期実行ジョブを保護するための鍵。
# Vercel Cron 等から `Authorization: Bearer <CRON_SECRET>` として呼び出してください。
CRON_SECRET=

# 通知連携 (任意・将来拡張)
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL_TO=

